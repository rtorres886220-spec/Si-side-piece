{
  "name": "gemini-sidekick-chrome-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:cosmos": "esbuild src/cosmosEngine.ts --bundle --minify --format=iife --outfile=public/cosmos.bundle.js",
    "pack:extension": "npm run build:cosmos && tsx scripts/pack-extension.ts",
    "build": "npm run build:cosmos && tsx scripts/pack-extension.ts && vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:grounding": "tsx scripts/test-grounding.ts",
    "test:benchmark": "tsx scripts/comprehensive-benchmark.ts",
    "test:tokens": "tsx scripts/test-token-optimization.ts",
    "test:audit": "tsx scripts/hard-validation-audit.ts",
    "test:red-team": "tsx scripts/production-red-team.ts",
    "test:multi-agent": "tsx scripts/benchmark-multi-agent.ts",
    "test:tabgroups": "tsx scripts/test-tabgroup-actionworker.ts",
    "test:scope": "tsx scripts/test-scope-resolution.ts",
    "test:pack": "tsx scripts/test-extension-packaging.ts",
    "test:apikey": "tsx scripts/test-api-key-verification.ts",
    "test:routing": "tsx scripts/test-phase3-phase4-routing-reliability.ts",
    "test:survey": "tsx scripts/test-survey-engine.ts",
    "test:doctor": "tsx scripts/test-doctor.ts",
    "test": "npm run test:doctor && npm run test:apikey && npm run test:grounding && npm run test:benchmark && npm run test:tokens && npm run test:scope && npm run test:tabgroups && npm run test:multi-agent && npm run test:pack && npm run test:routing && npm run test:survey"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.186.1",
    "tsx": "^4.21.0",
    "undici": "^8.11.2",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
